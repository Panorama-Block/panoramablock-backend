{
  "name": "liquidity-service",
  "version": "0.1.0",
  "description": "PanoramaBlock Liquidity Capability Service (AMM LP — Aerodrome on Base, future Trader Joe on Avalanche)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "zod": "^3.25.62"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20.17.43",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "blockchain",
    "liquidity",
    "amm",
    "aerodrome",
    "hexagonal-architecture",
    "capability-provider",
    "panoramablock"
  ],
  "author": "PanoramaBlock Team",
  "license": "MIT"
}
